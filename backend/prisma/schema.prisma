generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  tenant
  landlord
  admin
}

enum ListingType {
  rent
  lease
  sale
}

enum PropertyType {
  apartment
  house
  studio
  hostel
  commercial
  land
  vehicle
  machinery
  event_equipment
  event_venue
  agro_machinery
  medical_equipment
  solar_power
  fashion_attire
  it_hardware
  watercraft
  camping_sports
}

enum PropertyStatus {
  pending_review
  published
  rejected
  suspended
  expired
}

enum InquiryStatus {
  pending
  responded
  closed
}

enum ReportReason {
  fraudulent
  duplicate
  outdated
  misleading
  other
}

enum ReportStatus {
  pending
  reviewed
  action_taken
  dismissed
}

enum NotificationType {
  listing_approved
  listing_rejected
  listing_suspended
  listing_expired
  new_inquiry
  inquiry_responded
  report_received
  account_disabled
  account_enabled
}

// ─── Tables ───────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  firebase_uid    String?   @unique
  full_name       String
  email           String    @unique
  phone           String?
  password_hash   String    @default("")
  role            UserRole  @default(tenant)
  profile_image   String?
  is_verified     Boolean   @default(false)
  is_active       Boolean   @default(true)
  tos_accepted_at DateTime?
  tos_version     String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  // Relations
  properties           Property[]
  favorites            Favorite[]
  inquiries_as_tenant  Inquiry[]        @relation("InquiryTenant")
  inquiries_as_landlord Inquiry[]       @relation("InquiryLandlord")
  notifications        Notification[]
  reviews              Review[]
  listing_reports      ListingReport[]

  @@map("users")
}

model Property {
  id            String         @id @default(uuid())
  owner_id      String
  owner         User           @relation(fields: [owner_id], references: [id])

  title         String
  description   String
  property_type PropertyType
  listing_type  ListingType    @default(rent)

  price         Decimal        @db.Decimal(14, 2)

  // Address — real values are private, only exposed to connected parties
  real_address  String
  display_zone  String         // neighbourhood/zone name shown publicly
  display_lat   Float          // fuzzed lat for public map
  display_lng   Float          // fuzzed lng for public map
  real_lat      Float
  real_lng      Float

  bedrooms      Int            @default(0)
  bathrooms     Int            @default(0)
  area_sqft     Float?

  status           PropertyStatus @default(pending_review)
  rejection_reason String?
  is_available     Boolean        @default(true)
  expires_at       DateTime?      // auto-mark expired after this date

  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  // Relations
  images        PropertyImage[]
  amenities     PropertyAmenity[]
  favorites     Favorite[]
  inquiries     Inquiry[]
  reviews       Review[]
  reports       ListingReport[]

  @@index([owner_id])
  @@index([status])
  @@index([listing_type])
  @@index([property_type])
  @@index([display_zone])
  @@index([is_available])
  @@map("properties")
}

model PropertyImage {
  id          String   @id @default(uuid())
  property_id String
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)
  image_url   String   // watermarked URL
  is_primary  Boolean  @default(false)
  created_at  DateTime @default(now())

  @@index([property_id])
  @@map("property_images")
}

model Amenity {
  id         String            @id @default(uuid())
  name       String            @unique
  properties PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  property_id String
  amenity_id  String
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)
  amenity     Amenity  @relation(fields: [amenity_id], references: [id])

  @@id([property_id, amenity_id])
  @@map("property_amenities")
}

model Favorite {
  id          String   @id @default(uuid())
  user_id     String
  property_id String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now())

  @@unique([user_id, property_id])
  @@index([user_id])
  @@map("favorites")
}

model Inquiry {
  id            String        @id @default(uuid())
  property_id   String
  tenant_id     String
  landlord_id   String
  message       String
  viewing_date  DateTime?     // optional viewing request
  status        InquiryStatus @default(pending)
  response      String?       // landlord's reply
  responded_at  DateTime?
  created_at    DateTime      @default(now())

  property      Property      @relation(fields: [property_id], references: [id], onDelete: Cascade)
  tenant        User          @relation("InquiryTenant", fields: [tenant_id], references: [id])
  landlord      User          @relation("InquiryLandlord", fields: [landlord_id], references: [id])

  @@index([property_id])
  @@index([tenant_id])
  @@index([landlord_id])
  @@index([status])
  @@map("inquiries")
}

model ListingReport {
  id            String        @id @default(uuid())
  property_id   String
  reporter_id   String
  reason        ReportReason
  details       String?
  status        ReportStatus  @default(pending)
  admin_notes   String?
  resolved_by   String?
  created_at    DateTime      @default(now())
  resolved_at   DateTime?

  property      Property      @relation(fields: [property_id], references: [id], onDelete: Cascade)
  reporter      User          @relation(fields: [reporter_id], references: [id])

  @@index([property_id])
  @@index([reporter_id])
  @@index([status])
  @@map("listing_reports")
}

model AuditLog {
  id            String   @id @default(uuid())
  actor_id      String?
  action        String   // e.g. "listing_approved", "user_disabled", "listing_removed"
  target_type   String   // e.g. "property", "user"
  target_id     String
  details       Json?
  created_at    DateTime @default(now())

  @@index([actor_id])
  @@index([action])
  @@index([target_type])
  @@map("audit_logs")
}

model Review {
  id          String   @id @default(uuid())
  property_id String
  user_id     String
  property    Property @relation(fields: [property_id], references: [id])
  user        User     @relation(fields: [user_id], references: [id])
  rating      Int      // 1-5
  comment     String?
  created_at  DateTime @default(now())

  @@unique([property_id, user_id])
  @@index([property_id])
  @@map("reviews")
}

model Notification {
  id         String           @id @default(uuid())
  user_id    String
  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type       NotificationType
  content    String
  data       Json?
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())

  @@index([user_id])
  @@index([is_read])
  @@map("notifications")
}
